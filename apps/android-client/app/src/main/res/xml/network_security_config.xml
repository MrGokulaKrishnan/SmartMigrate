<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permit cleartext HTTP/TCP traffic for Direct LAN P2P connections to Windows Host -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Strict HTTPS enforcement for production web, CDN, and update endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">smartmigrate.web.app</domain>
        <domain includeSubdomains="true">smartmigrated.web.app</domain>
        <domain includeSubdomains="true">firebaseapp.com</domain>
    </domain-config>

    <!-- Scoped local loopback exemptions for developer bridges -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
